{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thai-talk-breaks",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static pages and lesson media, built into ./out by `npm run build:worker`.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Replaces the Supabase pg_cron job: every minute, small batches.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`, never in this file):
  //   DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, CRON_SECRET, ADMIN_TELEGRAM_USER_ID
  // Plain variable (can live here once the Worker URL is known):
  //   APP_URL  e.g. https://thai-talk-breaks.<your-subdomain>.workers.dev
}
