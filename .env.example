# Thai Talk Breaks — required environment variables
# Copy to .env.local for local development. Never commit the real file
# (.env.local is gitignored) — see AGENTS.md "Repository safety".
#
# Audio and images are pre-produced and already committed to the repo
# (curriculum/pilot/audio/, curriculum/pilot/images/) — no runtime AI
# generation is part of this application, so no AI-provider key belongs here.

# Telegram Bot API token, from @BotFather.
TELEGRAM_BOT_TOKEN=

# Shared secret used to verify that incoming webhook requests actually come
# from Telegram (checked against the secret_token Telegram sends back).
TELEGRAM_WEBHOOK_SECRET=

# Supabase project URL and service role key (server-side only — this key
# bypasses Row Level Security, so it must never be exposed to the client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required on scheduled/cron-triggered requests, so the lesson
# delivery endpoint can't be triggered by an arbitrary public request.
CRON_SECRET=

# Public base URL of the deployed application (used to construct webhook and
# callback URLs).
APP_URL=

# Numeric Telegram user ID (not a username) that /oops reports are DMed to.
# If unset, /oops reports are still saved — just no admin DM is attempted.
ADMIN_TELEGRAM_USER_ID=
