# reasoning as /public/day29/ above.
/public/lessons/

# Day 30 quiz Web App audio — synced at build time from
# curriculum/day30-audio/ (scripts/syncDay30QuizAssets.mjs), same
# derived-build-artifact reasoning as /public/day29/ above.
/public/day30-audio/
